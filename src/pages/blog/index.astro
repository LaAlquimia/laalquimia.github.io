---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Artículos y Research | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-[#080c14] text-slate-100 min-h-screen flex flex-col antialiased">
		<Header />
		<main class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 flex-1">
			
			<!-- Hero Section -->
			<div class="flex flex-col items-center text-center mb-10 sm:mb-16 max-w-3xl mx-auto">
				<span class="px-3.5 py-1 text-xs font-bold tracking-wider text-emerald-400 bg-emerald-950/40 border border-emerald-800/50 rounded-full mb-3 uppercase">
					Academia & Quant Research
				</span>
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-emerald-400 bg-clip-text text-transparent mb-4">
					Artículos y Modelos Cuantitativos
				</h1>
				<p class="text-sm sm:text-base text-gray-400 max-w-2xl leading-relaxed">
					Explora nuestras investigaciones sobre arbitraje delta-neutral, microestructura de mercado, reversión a la media y finanzas descentralizadas.
				</p>
			</div>

			<!-- Posts Grid -->
			<section class="w-full">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
					{
						posts.map((post) => (
							<article class="liquid-glass-card group flex flex-col justify-between overflow-hidden !p-0 rounded-2xl border border-white/10 bg-slate-900/40 hover:border-emerald-500/40 transition-all duration-300">
								<a href={`/blog/${post.slug}/`} class="flex flex-col h-full">
									{post.data.heroImage && (
										<div class="relative w-full aspect-[16/9] overflow-hidden bg-slate-950/80 border-b border-white/5">
											<img
												src={post.data.heroImage}
												alt={post.data.title}
												class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
												loading="lazy"
											/>
											<div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent"></div>
										</div>
									)}
									
									<div class="p-5 sm:p-6 flex flex-col flex-1 gap-3">
										<div class="flex items-center justify-between text-xs text-gray-400 font-mono">
											<span class="flex items-center gap-1.5 text-emerald-400/90 font-medium">
												<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
												</svg>
												<FormattedDate date={post.data.pubDate} />
											</span>
											<span class="px-2 py-0.5 rounded-full bg-white/5 text-[11px] text-gray-400 border border-white/5">
												Research
											</span>
										</div>

										<h2 class="text-lg sm:text-xl font-bold text-white group-hover:text-emerald-400 transition-colors line-clamp-2 leading-snug m-0 p-0">
											{post.data.title}
										</h2>

										{post.data.description && (
											<p class="text-xs sm:text-sm text-gray-400 line-clamp-3 leading-relaxed !mb-0">
												{post.data.description}
											</p>
										)}

										<div class="flex items-center gap-1.5 text-xs text-emerald-400 font-semibold pt-3 mt-auto border-t border-white/5 group-hover:translate-x-1 transition-transform">
											<span>Leer investigación</span>
											<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
											</svg>
										</div>
									</div>
								</a>
							</article>
						))
					}
				</div>
			</section>
			
		</main>

		<Footer />
	</body>
</html>
